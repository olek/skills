# Copy this file to ~/.codex/rules/familiar.rules, replace <codex-home> with
# the absolute path to the Codex configuration directory, then restart Codex.
# Match the installed skill path under <codex-home>/skills, not the source
# checkout path. Rule patterns do not expand environment variables or
# placeholders.
prefix_rule(
    pattern=["<codex-home>/skills/familiar/scripts/summon.sh"],
    decision="allow",
    justification="The Familiar launcher uses the selected terminal backend.",
)
prefix_rule(
    pattern=["<codex-home>/skills/familiar/scripts/status.sh"],
    decision="allow",
    justification="Familiar status reads managed terminal metadata through the selected backend.",
)
prefix_rule(
    pattern=["<codex-home>/skills/familiar/scripts/message.sh"],
    decision="allow",
    justification="Familiar follow-up delivery uses the selected terminal backend.",
)
prefix_rule(
    pattern=["<codex-home>/skills/familiar/scripts/dismiss.sh"],
    decision="allow",
    justification="Familiar dismissal uses the selected terminal backend.",
)
